="chooses from" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="Customer" target="Menu"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e34" value="cooks" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="Chef" target="Order"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e35" value="collects payment from" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="Cashier" target="Customer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e36" value="«throws»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="Staff" target="InvalidActionException"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e37" value="" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="VIPCustomer" target="Money"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e38" value="" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ComboMeal" target="Money"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e39" value="" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="PricingPolicy" target="Money"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n_poly" value="&lt;b&gt;B · Polymorphism&lt;/b&gt;&lt;br&gt;Each customer type overrides getSatisfactionLoss() (Regular 8, VIP 5, Critic 12); VIP overrides applyDiscount() for 10% off, and Critic overrides chooseItem() to order the slowest dish. GameController calls the same methods on every Customer, with no type checks." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="1740" width="600" height="70" as="geometry"/></mxCell><mxCell id="n_enc" value="&lt;b&gt;A · Encapsulation&lt;/b&gt;&lt;br&gt;All Customer fields are private. State only changes through seat(), placeOrder(), markServed() and so on, so a customer&#x27;s state, table and order stay consistent." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="1060" width="250" height="140" as="geometry"/></mxCell><mxCell id="n_enc_link" style="endArrow=none;dashed=1;html=1;strokeColor=#D6B656;" edge="1" parent="1" source="n_enc" target="Customer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n_comp" value="&lt;b&gt;D · Composition&lt;/b&gt;&lt;br&gt;Restaurant creates its Tables, Waiter, Host, Chef and Cashier itself; they only exist as part of the Restaurant." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1510" width="330" height="62" as="geometry"/></mxCell><mxCell id="n_comp_link" style="endArrow=none;dashed=1;html=1;strokeColor=#D6B656;" edge="1" parent="1" source="n_comp" target="Restaurant"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n_combo" value="&lt;b&gt;C · Composite menu item&lt;/b&gt;&lt;br&gt;ComboMeal is-a MenuItem and has two MenuItems, so it is ordered, priced and cooked like any other dish (Stage 3)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="1810" width="400" height="70" as="geometry"/></mxCell><mxCell id="n_combo_link" style="endArrow=none;dashed=1;html=1;strokeColor=#D6B656;" edge="1" parent="1" source="n_combo" target="ComboMeal"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>